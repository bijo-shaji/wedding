# =====================================================================
# SHEBA & KENNETH WEDDING INVITATION — ENVIRONMENT VARIABLES
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client-Side)
# ---------------------------------------------------------------------
# Cloudflare Turnstile Site Key (Public)
# Get this from Cloudflare Dashboard > Turnstile > Add Widget
# (Leave empty in local development to bypass visual captcha verification)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# BACKEND SERVERLESS CONFIGURATION (Vercel Server-Side Secrets)
# Never expose these keys to the client or commit them to source control
# ---------------------------------------------------------------------

# Cloudflare Turnstile Secret Key (Server-Side verification)
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Email Service (Transactional email delivery)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email address in Resend (e.g. invitations@shebakenneth.wedding)
# Note: For free trial accounts without a custom domain, you can test with:
# "Sheba & Kenneth Wedding <onboarding@resend.dev>"
RESEND_FROM_EMAIL=Sheba & Kenneth Wedding <onboarding@resend.dev>

# Organizer Private Inbox (Enquiries will be safely delivered here)
ORGANIZER_INBOX_EMAIL=organizer@example.com

# Upstash Redis (Distributed Rate Limiting)
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxxx-xxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx==

# Allowed Production Origin (Defense in depth against cross-origin abuse)
ALLOWED_ORIGIN=https://shebakenneth.wedding
